{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Entry",
  "description": "Single history entry for work session or discussion",
  "type": "object",
  "required": ["date", "topic", "summary"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date in YYYY-MM-DD format"
    },
    "topic": {
      "type": "string",
      "description": "Entry topic/title"
    },
    "summary": {
      "type": "string",
      "description": "Summary of work done or discussion"
    },
    "decisions": {
      "type": "array",
      "description": "List of decisions made",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "description": "Links to related documents or discussions",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label": {
            "type": "string",
            "description": "Link label"
          },
          "href": {
            "type": "string",
            "format": "uri",
            "description": "Link URL"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
