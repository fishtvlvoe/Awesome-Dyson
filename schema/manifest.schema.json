{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Manifest",
  "description": "Index of all history entries",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "description": "List of entry metadata",
      "items": {
        "type": "object",
        "required": ["date", "topic", "file"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date in YYYY-MM-DD format"
          },
          "topic": {
            "type": "string",
            "description": "Entry topic"
          },
          "file": {
            "type": "string",
            "description": "Filename of the entry (relative to entries/ directory)"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
